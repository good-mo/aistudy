# ═══ LLM Provider 配置 ═══
# 可选: openai | azure | local（OpenAI 兼容端点）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# OpenAI / OpenAI 兼容端点（必填）
# 本地兼容端点（如 vLLM/Ollama/LiteLLM）可填任意占位符，如 sk-local
OPENAI_API_KEY=sk-your-actual-key-here
# 可选：自定义 base_url（本地或兼容端点时配置）
# OPENAI_API_BASE=https://your-endpoint/api/v1
# 可选：自定义 HTTP 请求头（JSON 字符串）
# 某些服务（如 opencode.ai）使用 api-key 头而非 Authorization Bearer 认证
# 示例: {"api-key": "sk-your-key", "Authorization": ""}
# LLM_DEFAULT_HEADERS={}

# ═══ Azure OpenAI（可选）═══
# AZURE_API_KEY=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=2024-08-01-preview

# ═══ Agent 行为配置 ═══
MAX_RETRIES=3
MAX_COVERAGE_RETRIES=5
COVERAGE_THRESHOLD=80.0
TEST_TIMEOUT=60

# ═══ 服务配置 ═══
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# ═══ 持久化 ═══
CHECKPOINT_DB=checkpoints.db

# ═══ P0：异步任务队列 ═══
TASK_QUEUE_MAXSIZE=100
TASK_WORKERS=2
TASK_TIMEOUT=600

# ═══ P0：Docker 沙箱隔离 ═══
# 建议在仅运行 Python 的裸机/CI 环境关闭（无 docker 时自动降级为宿主机执行）
SANDBOX_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEM_LIMIT=512m
# 1 CPU = 1000000000
SANDBOX_NANO_CPUS=1000000000
# 安全起见默认禁用网络
SANDBOX_NETWORK_MODE=none

# ═══ LLM 限流重试 ═══
# 遇到 RateLimitError / FreeUsageLimitError（HTTP 429）时自动指数退避重试
LLM_RATE_LIMIT_MAX_RETRIES=3
LLM_RATE_LIMIT_BASE_DELAY=2.0
LLM_RATE_LIMIT_MAX_DELAY=30.0
LLM_RATE_LIMIT_BACKOFF_FACTOR=2.0
